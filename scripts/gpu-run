#!/bin/bash
# PCI retrain wrapper for GT 720M + bbswitch + kernel 6.1

modprobe bbswitch 2>/dev/null

# Only do the dance if GPU is failing to respond
if ! modprobe nvidia 2>/dev/null; then
    echo "[gpu-run] Retraining PCIe link..."
    [ -e /sys/bus/pci/devices/0000:01:00.0 ] && \
        echo 1 > /sys/bus/pci/devices/0000:01:00.0/remove
    echo OFF > /proc/acpi/bbswitch
    sleep 1
    echo ON  > /proc/acpi/bbswitch
    sleep 1
    echo 1 > /sys/bus/pci/rescan
    sleep 1
fi

exec optirun "$@"
